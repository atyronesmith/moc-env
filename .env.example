# Optional local credential selectors. Copy to .env; .env is Git-ignored.
# Do not put GITHUB_TOKEN or BWS_ACCESS_TOKEN in this file.

# Bitwarden Secrets Manager UUID for the secret whose key is GITHUB_TOKEN.
GITHUB_BWS_SECRET_ID=00000000-0000-0000-0000-000000000000

# macOS Keychain service containing the Bitwarden machine access token.
BWS_ACCESS_TOKEN_KEYCHAIN_SERVICE=jira-bws-access-token

# Optional macOS Keychain account; defaults to the current user.
# BWS_ACCESS_TOKEN_KEYCHAIN_ACCOUNT=current-user
